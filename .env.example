# --- Persistencia de Base de Datos ---
DATABASE_URL=sqlite:///backend/ddos_records.db
RETENTION_DAYS=30
MAX_DB_LOG_ROWS=50000
PERSIST_BENIGN=true
ANONYMIZE_IPS=true

# --- Seguridad y Autenticación (REEMPLAZAR ANTES DE PRODUCCIÓN) ---
SENSOR_API_KEY=REEMPLAZAR_CON_TOKEN_ALEATORIO_32_BYTES
ADMIN_USER=admin
ADMIN_PASSWORD=REEMPLAZAR_CON_CLAVE_ADMIN_SEGURA
SESSION_SECRET_KEY=REEMPLAZAR_CON_SECRETO_HMAC_64_HEX
SESSION_DURATION_HOURS=12
SOAR_MASTER_PASSWORD=REEMPLAZAR_CON_CLAVE_MAESTRA_SOAR_INDEPENDIENTE
# EDL_API_TOKEN=OPCIONAL_TOKEN_PARA_FEED_EDL_EXTERNO
SOAR_ENABLE_EXTERNAL_ENRICHMENT=true

# --- Certificados HTTPS / TLS (generar con: python generar_certificado_https.py) ---
# SSL_CERTFILE=backend/certs/cert.pem
# SSL_KEYFILE=backend/certs/key.pem

# --- Red y Simulación ---
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ENABLE_SIMULATION=false

# --- Modelo Conv1D ---
TF_INTRA_THREADS=2
DECISION_THRESHOLD=0.5

# --- Parámetros Operativos ---
MAX_BATCH_SIZE=500
WS_SEND_TIMEOUT_S=2.0
WS_MAX_FLOWS_PER_MESSAGE=10
TZ_OFFSET_HOURS=-5
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
