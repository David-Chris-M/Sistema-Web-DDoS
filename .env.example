# ============================================================
# CYBERSHIELD PYME - CONFIGURACIÓN DE PRODUCCIÓN 24/7
# ============================================================

# --- Persistencia de Base de Datos ---
# Para despliegue local rápido en Pyme (alta velocidad con SQLite en modo WAL):
DATABASE_URL=sqlite:///backend/ddos_records.db
# Para despliegue en servidor dedicado con PostgreSQL:
# DATABASE_URL=postgresql://cybershield_user:cybershield_secure_pass@localhost:5432/cybershield_pyme

# Política de retención: Purga automática de flujos individuales tras 30 días.
# Nota: La tabla 'traffic_minute_stats' conserva el histórico forense de forma permanente.
RETENTION_DAYS=30
PERSIST_BENIGN=true

# --- Seguridad e Ingesta Perimetral ---
# Clave secreta compartida entre el sensor perimetral y el servidor API (Cabecera X-API-Key)
SENSOR_API_KEY=CyberShield_Pyme_SecureToken_2026

# Orígenes CORS autorizados para el acceso al Dashboard desde la LAN de la Pyme
CORS_ORIGINS=*

# Desactivar endpoints de simulación manual en producción real
ENABLE_SIMULATION=false

# --- Optimización de Red Neuronal Conv1D en CPU ---
TF_INTRA_THREADS=2
DECISION_THRESHOLD=0.5

# --- Parámetros Operativos ---
MAX_BATCH_SIZE=500
WS_SEND_TIMEOUT_S=2.0
WS_MAX_FLOWS_PER_MESSAGE=10
TZ_OFFSET_HOURS=-5
LOG_LEVEL=INFO
